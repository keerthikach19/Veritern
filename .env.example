APP_ENV=local
APP_MODE=live
# Load the supplied five-company reference-text library; does not run OCR or AI.
REFERENCE_CASES_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=35
GROQ_MAX_ATTEMPTS=3
GROQ_MAX_CALLS_PER_CASE=3
GROQ_MAX_COMPLETION_TOKENS=3000
CASE_INPUT_TOKEN_BUDGET=36000
CASE_OUTPUT_TOKEN_BUDGET=12000
SEARCH_BACKEND=serper
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_AUTH_TOKEN=
SEARCH_QUERY_LIMIT=6
SEARCH_RESULTS_PER_QUERY=4
FETCH_PAGE_LIMIT=10
FETCH_MAX_PER_DOMAIN=4
FETCH_MAX_CONCURRENT=3
FETCH_TIMEOUT_SECONDS=12
FETCH_MAX_BYTES=2000000
MAX_REDIRECTS=3
CASE_DEADLINE_SECONDS=120
UPLOAD_MAX_FILES=5
UPLOAD_MAX_BYTES=10000000
PDF_MAX_PAGES=15
OCR_MAX_PAGES_PER_CASE=6
IMAGE_MAX_PIXELS=20000000
STORAGE_DIR=./private_data
RAW_UPLOAD_RETENTION_HOURS=24
PUBLIC_CACHE_TTL_HOURS=24
SAVE_CASE_HISTORY=false
ENABLE_PRIVATE_UPLOADS=true
DISPLAY_TIMEZONE=Asia/Kolkata
# Set true ONLY when using an ephemeral host. Saved history can disappear.
EPHEMERAL_STORAGE=false
